# Copy this file to .env and fill in the values. Never commit .env to GitHub.

# Free key from https://aistudio.google.com/apikey (leave empty for offline demo mode)
GEMINI_API_KEY=

# Password for the archivist (admin) pages
ADMIN_PASSWORD=change-me

# Any long random string (signs the login cookie)
SECRET_KEY=replace-with-a-long-random-string

# Only needed when running without Docker Compose, or when deploying (Supabase URL)
# DATABASE_URL=postgresql://archive:archive@localhost:5432/archive

# Optional: change models if Google renames them
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
